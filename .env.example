# OpenProject environment configuration
# Copy this file to .env and fill in your credentials.
# Environment variables take precedence over .env values.

# Preferred: an API token from OpenProject > My Account > Access tokens > API.
OPENPROJECT_API_KEY=

# Fallback: only used when OPENPROJECT_API_KEY is empty (legacy session login).
OPENPROJECT_USERNAME=
OPENPROJECT_PASSWORD=

OPENPROJECT_URL=https://openproject.danieleraiteri.duckdns.org
